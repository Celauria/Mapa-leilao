# Copie para .env e preencha. Não versione o .env.
ANTHROPIC_API_KEY=

# Telegram: fale com @BotFather -> /newbot (gera o token); mande uma mensagem ao bot
# e abra https://api.telegram.org/bot<TOKEN>/getUpdates para ver seu chat_id.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail (opcional). Gmail: smtp.gmail.com, porta 587, com "senha de app".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERTA_PARA=
